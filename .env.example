# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Your Supabase project reference ID (found in Project Settings → General)
VITE_SUPABASE_PROJECT_ID=

# Supabase anonymous / public key (safe to expose in the browser)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Full Supabase project URL (e.g. https://<project-id>.supabase.co)
VITE_SUPABASE_URL=

# ─── Supabase Edge Functions (set via `supabase secrets set`) ───────────────
# Supabase service role key — keep strictly server-side
SUPABASE_SERVICE_ROLE_KEY=

# AI provider key used by generate-app function (at least one required)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Paddle billing keys
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_STARTER_PRICE_ID=
PADDLE_PRO_PRICE_ID=
